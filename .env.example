APP_ENV=development

# Placeholder only. /health does not connect to a database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/portfolio_dev

# Alembic uses a direct development connection, never the Neon pooled URL.
DATABASE_DIRECT_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/portfolio_dev

# Generate each key with a cryptographically secure random generator; never reuse a sample value.
SESSION_HASH_KEY=replace-with-random-64-character-secret
LOGIN_RATE_KEY=replace-with-random-64-character-secret
AUTH_PROXY_KEY=replace-with-the-same-random-secret-as-frontend
PUBLIC_SITE_ORIGIN=http://localhost:4321
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Exact local allow-lists. Add approved preview/production hosts and origins later.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:4321

# Neon Object Storage S3-compatible credentials. Secrets stay in backend only.
AWS_ENDPOINT_URL_S3=https://storage-endpoint.example.invalid
AWS_ACCESS_KEY_ID=replace-with-secret
AWS_SECRET_ACCESS_KEY=replace-with-secret
AWS_REGION=us-east-2
AWS_S3_BUCKET=replace-with-bucket
# Set true only after confirming this bucket's access level is private in Neon Console/API.
AWS_S3_PRIVATE_BUCKET_CONFIRMED=false
